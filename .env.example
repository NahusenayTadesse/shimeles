# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# A path, not a URL — this is SQLite. The file is created on first run, and
# WAL mode plus the performance pragmas are applied by the app on connect
# (see src/lib/server/db/index.ts).
DATABASE_URL=local.db

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
ORIGIN="http://localhost:5173"

# Where uploaded files live. Public media and private case documents share this
# directory; what separates them is the `files.is_public` row, checked by
# /files/[name] before it serves a byte. Back this up with the database.
FILES_DIR=.tempFiles

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# 32+ characters, high entropy. Rotating it invalidates every session.
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Email (optional in development)
# ---------------------------------------------------------------------------
# With SMTP_HOST unset, sends are logged rather than attempted, so a missing
# mail server never breaks a form submission.
SMTP_HOST=""
SMTP_PORT="465"
# Optional. Left unset, it follows the port: implicit TLS on 465, STARTTLS
# otherwise. Set it only for a server that does something unusual.
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM_NAME="Shimeles Abera Foundation"

# The envelope sender. Defaults to SMTP_USER, which is what most providers
# want: Hostinger, Gmail and friends reject a From that is not the mailbox you
# authenticated as. Only set this if your provider allows sending as another
# address, or mail will start bouncing.
MAIL_FROM=""

# Where replies land. Several emails tell the reader they can just reply, and
# without this that reply goes to the SMTP mailbox, which nobody reads.
MAIL_REPLY_TO=""

# Last-resort recipient for staff notifications, when neither a form's own
# notify list nor the `contact.email_primary` setting names one. Defaults to
# SMTP_USER, which is the one address guaranteed to exist and be monitored.
MAIL_ADMIN=""

# ---------------------------------------------------------------------------
# Payment providers
# ---------------------------------------------------------------------------
# Per §7 of the technical spec, provider keys are deliberately NOT stored in
# the database and are not dashboard-editable. Bank account numbers are — they
# are public information and live in the `payment_accounts` table.
