# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# A path, not a URL — this is SQLite. The file is created on first run, and
# WAL mode plus the performance pragmas are applied by the app on connect
# (see src/lib/server/db/index.ts).
DATABASE_URL=local.db

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
ORIGIN="http://localhost:5173"

# Where uploaded files live. Public media and private case documents share this
# directory; what separates them is the `files.is_public` row, checked by
# /files/[name] before it serves a byte. Back this up with the database.
FILES_DIR=.tempFiles

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# 32+ characters, high entropy. Rotating it invalidates every session.
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Email (optional in development)
# ---------------------------------------------------------------------------
# With SMTP_HOST unset, sends are logged rather than attempted, so a missing
# mail server never breaks a form submission.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM_NAME="Shimeles Abera Foundation"

# ---------------------------------------------------------------------------
# Payment providers
# ---------------------------------------------------------------------------
# Per §7 of the technical spec, provider keys are deliberately NOT stored in
# the database and are not dashboard-editable. Bank account numbers are — they
# are public information and live in the `payment_accounts` table.
