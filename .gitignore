# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
# SQLite — the database and its write-ahead log. Both, or a restore from a
# committed .db would be missing the last transactions still sitting in the WAL.
*.db
*.db-shm
*.db-wal

# Uploaded files. Public media and private case documents both land here, so
# this must never be committed — it would put beneficiary documents in git.
/.tempFiles
/files

# Production bundle assembled by hand from `npm run build` — build output,
# runtime node_modules, a copy of the database and of the uploaded files.
/deploy
build.tar.gz
